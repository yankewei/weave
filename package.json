{
  "name": "weave",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "pnpm --filter @weave/contracts build && concurrently --kill-others --names contracts,server,web \"pnpm --filter @weave/contracts dev\" \"pnpm --filter @weave/server dev\" \"pnpm --filter @weave/web dev\"",
    "build": "pnpm -r build",
    "start:api": "pnpm --filter @weave/server start",
    "start:worker": "pnpm --filter @weave/server start:worker",
    "typecheck": "pnpm --filter @weave/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @weave/contracts build && pnpm -r test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check && pnpm build",
    "db:up": "docker compose --env-file .env up -d postgres",
    "db:down": "docker compose --env-file .env down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.9.2",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.9"
  }
}
