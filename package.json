{
  "name": "weave",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check && pnpm build",
    "db:up": "docker compose --env-file .env up -d postgres",
    "db:down": "docker compose --env-file .env down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:migrate:remote": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.69",
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/geist": "5.3.0",
    "@shadcn/react": "0.3.1",
    "@vercel/blob": "2.8.1",
    "ai": "7.0.141",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "diff": "9.0.0",
    "lucide-react": "1.57.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.21.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.9.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.9"
  }
}
