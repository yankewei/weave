{
  "name": "weave",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.x"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm --recursive --workspace-concurrency=1 run check && composer --working-dir=api check && pnpm test:cutover",
    "format": "prettier --write \"*.{md,json,yaml}\" docs .github",
    "format:check": "prettier --check \"*.{md,json,yaml}\" docs .github",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "db:up": "docker compose up -d postgres rustfs",
    "db:down": "docker compose down",
    "db:migrate": "docker compose run --rm --build migrate",
    "test:cutover": "node --test agent/test/cutover.integration.ts"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
