{
  "name": "@weave/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && concurrently --kill-others --names compiler,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "pnpm build && node --env-file-if-exists=../../.env dist/migrate.js"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.69",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@weave/contracts": "workspace:*",
    "ai": "7.0.141",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.10.0-beta.17"
  }
}
