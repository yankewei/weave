{
  "name": "weave/api",
  "description": "Weave business API on AMPHP",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "ext-pcntl": "*",
    "ext-pgsql": "*",
    "amphp/http-client": "^5.3",
    "amphp/http-server": "^3.4",
    "amphp/http-server-router": "^2.0",
    "amphp/log": "^2.0",
    "amphp/postgres": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "Weave\\Api\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "serve": "php bin/server.php",
    "check": "phpstan analyse --no-progress"
  },
  "require-dev": {
    "phpstan/phpstan": "^2"
  }
}
