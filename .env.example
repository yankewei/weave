POSTGRES_USER=weave
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=weave
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
# Optional: a single connection string, e.g. a pooled hosted database.
# DATABASE_URL=
APP_ORIGIN=http://localhost:8080
# Host port nginx publishes for `docker compose up`.
WEB_PORT=8080
# Proxies in front of the app that append to X-Forwarded-For (one nginx = 1).
# TRUSTED_PROXY_HOPS=1
# Server-side Command Code key. Never expose it to the browser.
CMD_API_KEY=
CMD_MODEL=deepseek/deepseek-v4.1-flash
# Default image store (ADR 0003): S3-compatible. Leave S3_ENDPOINT unset for the RustFS
# in compose (API tests on the host reach it at http://127.0.0.1:9000); set it to use
# an external store. The compose RustFS uses these keys as its root credentials.
# S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
S3_ACCESS_KEY_ID=weave-local
S3_SECRET_ACCESS_KEY=replace-with-local-secret
# S3_REGION=us-east-1
# S3_BUCKET=weave-uploads
# Host port compose publishes RustFS on.
# S3_PORT=9000
# 32-byte base64 key that encrypts workspace S3 secrets: openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=
# Shared secret the API sends to the internal agent service: openssl rand -base64 32
AGENT_SERVICE_TOKEN=
