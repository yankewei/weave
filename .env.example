HOST=127.0.0.1
PORT=3000
POSTGRES_USER=weave
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=weave
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
# Optional: a single connection string, e.g. a pooled hosted database.
# DATABASE_URL=
# Per-process pool size; keep it small on serverless.
DATABASE_POOL_MAX=10
APP_ORIGIN=http://127.0.0.1:3000
# 32-byte base64 key used to encrypt S3 secrets: openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=
# Server-side Command Code key. Never prefix it with NEXT_PUBLIC_.
CMD_API_KEY=
CMD_MODEL=deepseek/deepseek-v4.1-flash
